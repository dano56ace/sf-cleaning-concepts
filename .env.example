# South Florida Cleaning Concepts — Environment Configuration Template
# Copy to .env locally (never commit .env) and sync to Netlify Environment Variables.

# 1. Netlify Site Link & Admin API Guard
NETLIFY_SITE_ID=91550a48-365a-47fd-8b71-633339081066
NETLIFY_AUTH_TOKEN=
ADMIN_SECRET=

# 2. SiteGround Direct Outgoing SMTP & Incoming IMAP (contact@sfcleaningconcepts.com)
EMAIL_FROM="South Florida Cleaning Concepts <contact@sfcleaningconcepts.com>"
EMAIL_REPLY_TO=contact@sfcleaningconcepts.com
# Comma-separated list of internal team emails that receive instant quote/lead notifications
EMAIL_LEAD_RECIPIENTS=contact@sfcleaningconcepts.com
SMTP_HOST=mail.sfcleaningconcepts.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@sfcleaningconcepts.com
SMTP_PASS=
# Optional: set if mail.sfcleaningconcepts.com presents SiteGround's shared certificate hostname
SMTP_TLS_SERVERNAME=

IMAP_HOST=mail.sfcleaningconcepts.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=contact@sfcleaningconcepts.com
IMAP_PASS=
